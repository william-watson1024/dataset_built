{
  "id": "finqa:train:12345",                       // 全局唯一样本 ID
  "source": "FinQA",                               // 原始数据集名称
  "split": "train",                                // 统一数据划分：train / validation / test
  "task": "financial_reasoning",                   // 统一后的任务类型
  "language": "en",                                // 样本主要语言，如 en / zh / ja

  "input": {                                       // 模型实际输入
    "images": [                                    // 输入图片资源列表；无图片时为空数组
      {
        "storage": "file",                         // 存储类型：file / zip / parquet
        "path": "media/finqa/12345.png"            // 图片或容器文件路径
      }
    ],                                             // 图片资源列表结束

    "context": "Revenue increased from ...",       // 模型参考材料，如正文、长文档、序列化表格；没有时为空字符串
    "prompt": "What is the percentage increase?",  // 当前需要模型完成的问题或指令

    "history": [                                   // 当前问题之前的历史对话；单轮任务为空数组
      {
        "role": "user",                            // 消息角色：user / assistant
        "content": "What was the revenue in 2021?" // 历史消息文本
      },
      {
        "role": "assistant",                       // 消息角色：user / assistant
        "content": "$56 million"                   // 历史 assistant 回复
      }
    ]                                              // 历史对话结束
  },                                               // 模型输入结束

  "output": {                                      // 模型需要学习生成的目标
    "text": "14.46%",                              // SFT 时使用的标准目标文本
    "format": "text",                              // 输出格式：text / number / json / html
    "references": [                                // 评测时允许的等价正确答案
      "14.46 percent"                              // 一个等价参考答案
    ]                                              // 参考答案列表结束
  },                                               // 模型输出结束

  "annotations": {                                 // 不默认作为模型输出的额外监督与评测信息
    "supervision": {                               // 可用于额外训练监督的信息
      "program": "divide(8.1, 56.0)",              // FinQA 等数据提供的计算程序
      "derivation": null                           // TAT-QA 等数据提供的推导过程；没有时为 null
    },                                             // 额外监督结束

    "evaluation": {                                // 当前样本特有的官方评测属性
      "answer_type": "arithmetic",                 // 官方答案类型
      "scale": "percent"                           // 数值答案的尺度或单位
    },                                             // 样本评测属性结束

    "raw": {                                       // 必须保留但暂未统一语义的原始字段
    }                                              // 原始字段结束
  },                                               // annotations 结束

  "meta": {                                        // 数据管理、追踪、去重与复现信息
    "source_id": "12345",                          // 原始数据集中的样本 ID
    "group_id": "finqa:report:xxx",                // 同一文档/表格/图片共享的分组 ID
    "subset": null,                                // 数据集内部子任务；没有时为 null
    "original_split": "train",                     // 原始数据集中的 split 名称
    "transforms": [                                // 原始数据到当前样本经历的转换
      "table_to_image:v1"                          // 例如表格渲染为图片
    ]                                              // 转换记录结束
  }                                                // meta 结束
}
// images 的三种合法形式
// {
//   "storage": "file",                                       // 普通文件
//   "path": "media/docvqa/page001.png"                       // 图片路径
// }
// {
//   "storage": "zip",                                // 图片位于 ZIP 文件中
//   "path": "raw/mmtab/images.zip",                  // ZIP 文件路径
//   "member": "images/table_001.png"                 // ZIP 内部图片路径
// }

// {
//   "storage": "parquet",                            // 图片内嵌在 Parquet 中
//   "path": "raw/docvqa/train-00000.parquet",        // Parquet 文件路径
//   "row": 123,                                      // 图片所在行
//   "field": "image"                                 // 图片所在字段
// }
